---
import Layout from '@/layouts/Layout.astro'
import { template } from '@/settings'
---

<Layout title="Page Not Found | Runzhe Zhang">
  <div class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="mb-4 text-xs font-bold tracking-[0.2em] text-primary uppercase">Page Not Found</p>
    <h1 class="mb-5 text-7xl font-black">404</h1>
    <p class="mb-8 text-lg text-base-content/70">This page does not exist.</p>
    <a href={`${template.base}/`} class="btn btn-primary">Back to Home</a>
  </div>
</Layout>
