---
import Layout from '@/layouts/Layout.astro'
import { projects } from '@/data/research'
---

<Layout title="Research | Runzhe Zhang" description="Research projects by Runzhe Zhang in multi-agent systems, diffusion language models, and molecular generation.">
  <header class="mb-12 border-b border-base-300 pb-9">
    <p class="mb-3 text-xs font-bold tracking-[0.18em] text-primary uppercase">Research Projects</p>
    <h1 class="mb-4 text-4xl font-black">Research Projects</h1>
    <p class="max-w-3xl text-lg leading-8 text-base-content/70">My work spans multi-agent systems and generative models, with an emphasis on method design and empirical evaluation.</p>
  </header>

  <div class="space-y-8">
    {projects.map(project => (
      <article id={project.id} class="scroll-mt-8 rounded-2xl border border-base-300 bg-base-100 p-7 shadow-sm md:p-9">
        <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="mb-2 text-xs font-bold tracking-[0.15em] text-primary uppercase">{project.shortTitle}</p>
            <h2 class="text-2xl font-bold leading-snug">{project.title}</h2>
          </div>
          <span class="rounded-full bg-primary/10 px-4 py-2 text-sm font-medium text-primary">{project.period}</span>
        </div>
        <p class="mb-5 text-base leading-7 text-base-content/75">{project.summary}</p>
        <ul class="mb-6 list-disc space-y-2 pl-5 leading-7 text-base-content/80">
          {project.details.map(detail => <li>{detail}</li>)}
        </ul>
        <div class="flex flex-wrap items-center gap-2 border-t border-base-300 pt-5">
          <span class="mr-2 text-sm font-medium">{project.role}</span>
          <span class="inline-block max-w-full rounded-lg border border-base-300 px-2 py-1 text-xs leading-5 text-base-content/75">{project.status}</span>
          {project.tags.map(tag => <span class="badge badge-ghost text-xs">{tag}</span>)}
        </div>
      </article>
    ))}
  </div>
</Layout>
