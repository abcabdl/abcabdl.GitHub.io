---
import Layout from '@/layouts/Layout.astro'
import { profile, template } from '@/settings'
import { projects } from '@/data/research'
import { publications } from '@/data/cv'
import Hero from '@/components/ui/Hero.astro'
---

<Layout>
  <section class="border-b border-base-300 pb-12">
    <Hero fullName={profile.fullName} title={profile.title} institute={profile.institute} />
  </section>

  <section class="py-12 border-b border-base-300">
    <div class="mb-7 flex items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-bold tracking-[0.18em] text-primary uppercase">Research</p>
        <h2 class="text-3xl font-bold">Research Interests</h2>
      </div>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {profile.research_areas.map((area, index) => (
        <div class="rounded-2xl border border-base-300 bg-base-200/50 p-6">
          <span class="text-xs font-mono text-primary/70">0{index + 1}</span>
          <h3 class="mt-4 mb-2 text-xl font-bold">{area.title}</h3>
          <p class="leading-7 text-base-content/70">{area.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-12 border-b border-base-300">
    <div class="mb-7 flex items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-bold tracking-[0.18em] text-primary uppercase">Selected Work</p>
        <h2 class="text-3xl font-bold">Research Projects</h2>
      </div>
      <a href={`${template.base}/research`} class="link link-primary whitespace-nowrap">All projects →</a>
    </div>
    <div class="space-y-4">
      {projects.map(project => (
        <a href={`${template.base}/research#${project.id}`} class="group block rounded-2xl border border-base-300 p-6 transition hover:border-primary/50 hover:bg-base-200/50">
          <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-semibold tracking-widest text-primary">{project.shortTitle}</span>
            <span class="text-sm text-base-content/50">{project.period}</span>
          </div>
          <h3 class="mb-2 text-xl font-bold group-hover:text-primary">{project.title}</h3>
          <p class="leading-7 text-base-content/70">{project.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="py-12">
    <div class="mb-7 flex items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-bold tracking-[0.18em] text-primary uppercase">Publications</p>
        <h2 class="text-3xl font-bold">Publications</h2>
      </div>
      <a href={`${template.base}/papers`} class="link link-primary whitespace-nowrap">View all →</a>
    </div>
    <div class="space-y-5">
      {publications.map(paper => (
        <div class="border-l-2 border-primary/60 pl-5">
          {paper.link
            ? <h3 class="font-semibold leading-7"><a href={paper.link} target="_blank" rel="noopener noreferrer" class="hover:text-primary hover:underline">{paper.title} ↗</a></h3>
            : <h3 class="font-semibold leading-7">{paper.title}</h3>}
          <p class="mt-1 text-sm text-base-content/60">{paper.journal}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
